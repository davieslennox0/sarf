# Sarf environment. Copy to .env (gitignored) and fill in.
# NO real values in this file — it is committed.

# --- FastAPI MCP server ---
# Caddy terminates TLS and proxies here
SARF_HOST=127.0.0.1
SARF_PORT=8760
SARF_DB_PATH=./data/sarf.db
# Public origin of the dashboard/signer frontend — every proposal's sign_url
# is minted from this. The MCP connector lives on its own host
# (https://mcp.getsarf.xyz/mcp); see Caddyfile.example.
SARF_PUBLIC_URL=https://getsarf.xyz
# Public MCP connector origin — only used to render the user's personal
# connector URL on the dashboard after sign-in.
SARF_MCP_PUBLIC_URL=https://mcp.getsarf.xyz

# --- Auth (see SECURITY.md "Auth model") ---
# production = fail closed: startup refuses without SARF_SESSION_SECRET and
# /mcp refuses unauthenticated requests. dev = local testing only (warns
# loudly on every unauthenticated request).
SARF_ENV=production
# Session-token signing secret, >= 32 chars: `openssl rand -hex 32`
SARF_SESSION_SECRET=
# Session lifetime in seconds (default 1800 = 30 min; hard-capped at 3600 in
# code). Expiry always means signing in with the wallet again.
SESSION_TTL_SECONDS=1800

# --- X Layer ---
# JSON-RPC for chain 196. Checked at startup: in production the server refuses
# to boot if this endpoint does not report chain 196, because a trading server
# silently pointed at the wrong chain is worse than one that will not start.
XLAYER_RPC_URL=https://rpc.xlayer.tech

# --- OKX DEX aggregator credentials ---
# From https://web3.okx.com/build/dev-portal — a DEX API project, not an
# exchange account. Quotes, swap calldata and the platform fee all come from
# this API; without the three of them the server falls back to the local
# `onchainos` CLI, and with neither, priced calls fail closed rather than
# invent a number.
#
# These are read-only market-data credentials. They cannot move funds, and they
# are not the same thing as exchange trading keys — do not put those here.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# --- Relayer ---
# Private key of the wallet that submits sponsored transactions: EIP-7702
# authorisations, session-key executions, and the CCTP mint leg of a deposit.
#
# THE ONLY PRIVATE KEY THIS SERVER HOLDS, and it is deliberately a dedicated
# wallet that holds GAS AND NOTHING ELSE. It is not a treasury, it is not the
# fee address, and it never holds user funds — see README "Why the relayer
# holds only gas". Compromising this box therefore costs the gas float, not
# anyone's money. Keep it that way: never fund this address with anything you
# would mind losing.
SARF_RELAYER_PRIVATE_KEY=

# Signs the Base-side gas top-up that lets a depositor send their own CCTP
# burn (deposit.send_gas). Left unset it falls back to SARF_RELAYER_PRIVATE_KEY
# above, which is correct only when that one wallet is funded on BOTH chains —
# a full X Layer balance says nothing about Base, and a MoonPay deposit needs
# Base. Set this when Base gas comes from a different wallet.
#
# The "gas and nothing else" rule above applies here just as much, and is
# harder to keep: whatever wallet you point at this can be drained to the
# ceiling in BASE_GAS_DRIP_* below. Do not reuse an operating wallet unless you
# accept that a compromise of this box reaches it.
SARF_BASE_RELAYER_PRIVATE_KEY=

# --- Risk parameters (server-side caps; see SECURITY.md for rationale) ---
# Max leverage multiplier accepted from the LLM layer. Hard-clamped in code
# at 5.0 regardless of this value.
LEVERAGE_MAX_MULTIPLIER=3.0
# Per-proposal USD cap (0 disables). Applies to deposit/borrow/withdraw/repay.
MAX_PROPOSAL_USD=250000
# Proposal expiry in seconds (signed tx must come back within this window).
PROPOSAL_TTL_SECONDS=600

# Comma-separated asset symbols enabled for tools (subset of the built-in
# per-market whitelist; empty = built-in default set).
ASSET_WHITELIST=

# --- Admin console (/admin) ---
# Who may open the operator console, by GOOGLE address, comma-separated.
# Empty (the default) means the console does not exist: every /api/admin route
# refuses everyone and the Admin tab never appears. It fails closed.
#
# The gate is NOT the browser's word for who is logged in. It is a Privy
# identity token — a JWT Privy signs — whose signature, issuer, audience and
# expiry this server verifies before reading the Google-verified email out of
# it (server/sarf/privy_auth.py). A valid Sarf wallet session is required as
# well, so an admin request carries two independent credentials.
#
# Exact match after lowercasing. Gmail dots and +tags are NOT folded: write
# the address exactly as Google reports it.
SARF_ADMIN_EMAILS=
# The Privy app the identity token must have been minted FOR. Must equal
# frontend/.env's VITE_PRIVY_APP_ID. Without it as the expected audience, a
# token from ANY other Privy app would verify against the same issuer key —
# and anyone can create an app and put any email in it.
PRIVY_APP_ID=
# Optional, and normally EMPTY. Signing keys are fetched from Privy's per-app
# JWKS at https://auth.privy.io/api/v1/apps/$PRIVY_APP_ID/jwks.json and cached,
# so a Privy key rotation needs no change here and no restart.
#
# Setting this pins verification to ONE key and disables the JWKS lookup. Privy
# publishes more than one signing key per app, so a pinned key stops verifying
# the moment tokens are signed with the other one — and the symptom is the
# admin console refusing the only person it admits. Use it only where the
# server cannot make outbound requests. PEM, PEM with escaped newlines, or the
# bare base64 body are all accepted.
PRIVY_VERIFICATION_KEY=

# --- Dashboard / stats ---
# TVL + user-count snapshot refresh interval (background job; page loads
# never trigger on-chain scans).
STATS_REFRESH_SECONDS=90

# Frontend build-time variables live in frontend/.env — every VITE_ prefixed
# value is compiled into the client bundle, so nothing secret may go there.

# Hostnames Caddy fronts this process with (MCP Host-header validation).
SARF_ALLOWED_HOSTS=mcp.getsarf.xyz,getsarf.xyz,www.getsarf.xyz,sarf-mcp.managerx.xyz
# MCP hosts from before the move to getsarf.xyz that keep serving existing
# connectors. OAuth discovery on them describes the old host itself.
SARF_LEGACY_MCP_HOSTS=sarf-mcp.managerx.xyz

# --- Platform fee ---
# Flat fee per swap, charged in the stablecoin leg and collected natively by
# the OKX aggregator inside the user's own transaction (no second transfer,
# no custody). Requires the HTTP transport (OKX API credentials) — on the CLI
# transport orders are built WITHOUT a fee and say so in the response.
PLATFORM_FEE_USD=0.01
# No address = no fee is charged. It never falls back to some other address.
PLATFORM_FEE_ADDRESS=
MIN_ORDER_USD=0
MAX_FEE_PERCENT=3.0

# --- Single-asset zap (server/sarf/xlayer/zap.py) ----------------------------
# IL watcher: flips positions to exit_pending / reentry_pending when IL crosses
# a user's thresholds. It moves no funds; the user's wallet signs every step.
# Off by default. Turn on once the pools in xlayer/zap_pools.json are verified.
ZAP_AUTOEXIT_ENABLED=false
ZAP_WATCH_INTERVAL_SECONDS=60
# Tolerance on in-pool swaps and add/remove-liquidity minimums, in percent.
ZAP_SLIPPAGE_PCT=1.0
