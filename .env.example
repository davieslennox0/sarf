# SuiFlow environment. Copy to .env (gitignored) and fill in.
# NO real values in this file — it is committed.

# --- FastAPI MCP server ---
SUIFLOW_HOST=127.0.0.1            # Caddy terminates TLS and proxies here
SUIFLOW_PORT=8760
SUIFLOW_DB_PATH=./data/suiflow.db
SUIFLOW_PUBLIC_URL=https://suiflow.example.com

# --- Tx-builder sidecar (Node). MUST stay on loopback: it is not hardened
#     for public exposure; the Python server is the only intended client. ---
TXBUILDER_HOST=127.0.0.1
TXBUILDER_PORT=8761

# --- Sui / protocol endpoints ---
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
PYTH_HERMES_URL=https://hermes.pyth.network
# Current Finance quote server (required only for propose_leverage_position;
# leave empty to disable the leverage tool gracefully).
CURRENT_QUOTE_SERVER_URL=

# --- Risk parameters (server-side caps; see SECURITY.md for rationale) ---
# Max leverage multiplier accepted from the LLM layer. Hard-clamped in code
# at 5.0 regardless of this value.
LEVERAGE_MAX_MULTIPLIER=3.0
# Per-proposal USD cap (0 disables). Applies to deposit/borrow/withdraw/repay.
MAX_PROPOSAL_USD=250000
# Proposal expiry in seconds (signed tx must come back within this window).
PROPOSAL_TTL_SECONDS=600

# Comma-separated asset symbols enabled for tools (subset of the built-in
# per-market whitelist; empty = built-in default set).
ASSET_WHITELIST=
