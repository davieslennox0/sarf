# Caddy reverse proxy for Sarf. Only the MCP endpoint, dashboard, signer and
# API are exposed; the tx-builder sidecar (8761) must never appear here.
sarf.example.com {
	encode zstd gzip

	# MCP + health + dashboard/signer + REST API. Everything else 404s.
	@allowed path / /mcp /mcp/* /healthz /sign /dashboard /dashboard/* /api/*
	handle @allowed {
		reverse_proxy 127.0.0.1:8760
	}
	handle {
		respond 404
	}
}
