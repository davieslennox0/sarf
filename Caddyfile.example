# Caddy reverse proxy for Sarf. Both hosts front the same FastAPI process on
# 127.0.0.1:8760 — the split is a path allowlist per audience, not two
# deployments. The tx-builder sidecar (8761) must never appear here.

# Frontend: dashboard, in-chat signer, and the REST API they call
# (same-origin, so no CORS surface). This is what SARF_PUBLIC_URL points at —
# every proposal's sign_url is minted on this host.
sarf.managerx.xyz {
	encode zstd gzip

	@allowed path / /dashboard /dashboard/* /sign /authorize /api/* /.well-known/* /healthz
	handle @allowed {
		reverse_proxy 127.0.0.1:8760
	}
	handle {
		respond 404
	}
}

# MCP endpoint for Claude / ChatGPT connectors. Nothing but the MCP
# transport (and health) is reachable on this host.
sarf-mcp.managerx.xyz {
	encode zstd gzip

	@allowed path /mcp /mcp/* /.well-known/* /healthz
	handle @allowed {
		reverse_proxy 127.0.0.1:8760
	}
	handle {
		respond 404
	}
}
