# Privy app ID — Configuration > App settings > Basics in the Privy dashboard.
#
# This is the PUBLIC identifier and it ships inside the JS bundle, which is
# fine and expected. The app SECRET from that same page is for server-side
# Privy APIs, is not used by Sarf, and must never appear in this file — every
# VITE_ prefixed variable is compiled into client-side code.
#
# Unset = Privy is off and the site falls back to the injected wallet
# (OKX Wallet), exactly as it behaved before this integration.
VITE_PRIVY_APP_ID=
